      "css": ".ds-search{position:relative;color:#6b6b70}.ds-search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none}.ds-field{appearance:none;width:100%;min-height:44px;border:1px solid transparent;border-radius:980px;background:rgba(120,120,128,.12);color:#1d1d1f;font:17px -apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;padding:0 14px 0 42px;transition:background .2s,border-color .2s,box-shadow .2s}.ds-field::placeholder{color:#6b6b70}.ds-field:focus{outline:0;background:#fff;border-color:#006edb;box-shadow:0 0 0 4px rgba(0,113,227,.22)}"
