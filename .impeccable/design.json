    {
      "name": "Package Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Catalog tile with title, two-line description and meta.",
      "html": "<a class=\"ds-card\"><h3>aihub-guide</h3><p>How to use AI Hub from any assistant, with offline docs bundled.</p><div class=\"ds-meta\"><span class=\"ds-badge\">skill</span><span>v1.2.0</span></div></a>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:6px;min-height:150px;background:#fff;border-radius:14px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 6px 24px rgba(0,0,0,.06);padding:22px;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s}.ds-card:hover{transform:translateY(-3px);box-shadow:0 2px 4px rgba(0,0,0,.05),0 14px 36px rgba(0,0,0,.1)}.ds-card h3{margin:0;font-size:19px;font-weight:600;letter-spacing:-.025em}.ds-card p{margin:0;flex:1;font-size:15px;line-height:1.4;color:#636366}.ds-meta{display:flex;gap:12px;align-items:center;font-size:13px;color:#6b6b70}.ds-badge{font-size:12px;font-weight:500;padding:2px 9px;border-radius:980px;background:rgba(0,113,227,.14);color:#006edb}"
    },
    {
      "name": "Inset Grouped List",
      "kind": "custom",
      "refersTo": "card",
      "description": "Ranked rows with inset separators and proportional bar.",
      "html": "<div class=\"ds-list\"><div class=\"ds-li\"><span class=\"ds-rank top\">1</span><div class=\"ds-t\"><b>aihub-policy</b><span>setup</span></div><span class=\"ds-n\">1,284</span></div><div class=\"ds-li\"><span class=\"ds-rank\">2</span><div class=\"ds-t\"><b>aihub-bot</b><span>bot</span></div><span class=\"ds-n\">902</span></div></div>",
      "css": ".ds-list{background:#fff;border-radius:14px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 6px 24px rgba(0,0,0,.06);overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;color:#1d1d1f}.ds-li{display:flex;align-items:center;gap:14px;padding:13px 18px;min-height:52px;position:relative}.ds-li+.ds-li::before{content:'';position:absolute;top:0;left:18px;right:0;border-top:1px solid rgba(60,60,67,.14)}.ds-t{flex:1;min-width:0}.ds-t b{display:block;font-weight:500}.ds-t span{font-size:14px;color:#636366}.ds-n{font-variant-numeric:tabular-nums;color:#636366}.ds-rank{width:26px;height:26px;border-radius:50%;background:rgba(120,120,128,.12);display:grid;place-items:center;font-size:13px;font-weight:600;color:#636366}.ds-rank.top{background:#006edb;color:#fff}"
