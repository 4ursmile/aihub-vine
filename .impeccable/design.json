  "narrative": {
    "northStar": "The Glass Ledger",
    "overview": "AI Hub reads like a well-kept ledger seen through frosted glass: neutral, precise and number-forward, with the packages and usage figures as the only things that shout. It borrows Apple's Human Interface language: system font, tight-tracked headings, pill buttons, inset-grouped lists and a translucent blurred nav. Color is almost absent: grey ink, white surfaces and one themable accent; status hues appear only for status.",
    "keyCharacteristics": [
      "System font stack only; no webfonts.",
      "One accent, admin-themable from eight choices, default Apple blue.",
      "Inset-grouped lists and pill controls; 14px surface radius, 10px field radius.",
      "Light and dark follow the OS; dark is true black.",
      "Translucent sticky nav with backdrop blur and a hairline."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The accent marks what is interactive or selected and nothing else; status colors mark status and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Tokens-Only Rule",
        "body": "Colors come from the CSS variables so light, dark and every accent theme work together. A literal hex in a component is a bug.",
        "section": "colors"
      },
      {
        "name": "The Tight Tracking Rule",
        "body": "Tracking tightens as size grows. Never apply it to monospace or all-caps.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can change or be compared uses tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Rest Is Calm Rule",
        "body": "Surfaces are quiet at rest; the stronger shadow appears only in response to hover or an open popover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use CSS variables for every color so dark mode and the eight accents keep working.",
      "Do keep controls at 44px and visible 3px accent focus rings (WCAG AA).",
      "Do animate only transform and opacity, and respect prefers-reduced-motion.",
      "Do use pills for actions and filters, 14px radius for containers.",
      "Do let numbers be tabular and let the live feed and dashboard carry the energy."
    ],
    "donts": [
      "Don't add a second accent or use status colors as decoration.",
      "Don't load webfonts or add a build step; the system stack and no-build SPA are fixed.",
      "Don't put borders around cards; separation comes from shadow in light mode and tone in dark.",
      "Don't convey state by color alone (add text, icon or position).",
      "Don't set essential text in Tertiary Ink (#6b6b70) or 12px tinted-badge text without checking AA contrast."
    ]
  }
}