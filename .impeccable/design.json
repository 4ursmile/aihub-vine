      "css": ".ds-seg{display:inline-flex;background:rgba(120,120,128,.12);border-radius:9px;padding:2px;gap:2px}.ds-seg button{appearance:none;border:0;background:transparent;color:#1d1d1f;font:500 13px -apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;padding:6px 16px;border-radius:7px;min-height:30px;cursor:pointer}.ds-seg button.on{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.18)}.ds-seg button:focus-visible{outline:3px solid rgba(0,113,227,.55);outline-offset:2px}"
