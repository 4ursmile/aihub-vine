# AI Hub server configuration.  Copy to .env and edit:   cp .env.example .env
# Lookup order: --env-file flag, $AIHUB_ENV_FILE, ./.env, <data dir>/.env.   Real environment variables override this file.
# Secrets can also come from files (Docker/Kubernetes secrets): set AIHUB_<NAME>_FILE=/run/secrets/<file> instead of AIHUB_<NAME>.
# Check your setup without starting the server:   python -m aihub.server --check

# ---------------------------------------------------------------- Docker Compose secrets (used by docker-compose.yml)
# Set the ones for the bundled services you enable with --profile. Compose builds the connection URLs from these.
# POSTGRES_PASSWORD=CHANGE_ME
# REDIS_PASSWORD=CHANGE_ME
# MINIO_ROOT_USER=aihub
# MINIO_ROOT_PASSWORD=CHANGE_ME_LONG
# Do not write ${VAR} inside .env values: env files are not expanded.

# ---------------------------------------------------------------- server
AIHUB_PUBLIC_URL=http://localhost:8000      # the URL clients use (your reverse-proxy URL); used in download links, install.sh/install.ps1, the web UI install commands and the CLI default hub
AIHUB_DATA_DIR=./aihub-data
AIHUB_OPEN_REGISTRATION=true                # default sign-up policy; admins can change it later in the UI
AIHUB_LOG_LEVEL=INFO

# ---------------------------------------------------------------- database: sqlite (default) | postgres
AIHUB_DB_BACKEND=sqlite
# AIHUB_SQLITE_PATH=./aihub-data/aihub.db   # default: <data dir>/aihub.db
# --- postgres: either one URL ...
# AIHUB_DATABASE_URL=postgresql://aihub:CHANGE_ME@db:5432/aihub?sslmode=prefer
# --- ... or the parts (the URL wins if both are set)
# AIHUB_PG_HOST=localhost
# AIHUB_PG_PORT=5432
# AIHUB_PG_NAME=aihub
# AIHUB_PG_USER=aihub
# AIHUB_PG_PASSWORD=CHANGE_ME
# AIHUB_PG_SSLMODE=prefer                   # use "require" or "verify-full" for remote databases
# AIHUB_PG_POOL_SIZE=10

# ---------------------------------------------------------------- cache: memory (built in, default) | redis | none
AIHUB_CACHE_BACKEND=memory
AIHUB_CACHE_TTL=20                          # seconds for list/search results
# AIHUB_CACHE_MAX_ITEMS=2048                # memory backend only
# AIHUB_REDIS_URL=redis://:CHANGE_ME@redis:6379/0     # rediss:// for TLS. Required when the backend is redis.
# AIHUB_REDIS_PREFIX=aihub:

# ---------------------------------------------------------------- Langfuse + git (where packages and usage live now)
# The server stores no package files. It pulls usage events from Langfuse and the package index from git.
# Everything below can also be set in Admin > Sync. ENVIRONMENT WINS OVER ADMIN SETTINGS: a value set here is used and the saved Admin value is ignored (the admin page shows "Set by environment").
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
# LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
# AIHUB_INDEX_URL=https://gitlab.example.com/team/aihub-index.git     # repo (or https URL of the json) holding the package index
# AIHUB_INDEX_BRANCH=main
# AIHUB_INDEX_PATH=index                    # folder index (root.json + catalog/ + packages/); an old index.json file is still read
# AIHUB_CLI_GIT_URL=https://gitlab.example.com/team/aihub.git        # shown on Get started for "pip install from git". Environment wins over Admin > Sync
# AIHUB_CLI_GIT_BRANCH=main                 # optional: install from this branch (empty = hidden)
# AIHUB_CLI_GIT_SUBDIR=cli                  # optional: install from this sub folder of the repo (empty = hidden)

# ---------------------------------------------------------------- database backup (into the index git repo, under backups/)
# Scheduled dump of every table to small gzipped SQLite files + backups/index.json. Credentials are hashed/redacted first.
# Needs the index repo above and git push rights for the server's git credentials. Schedule/chunk size: Admin > Backup.
# AIHUB_BACKUP_ENABLED=true

# ---------------------------------------------------------------- legacy package storage (only for aihub.server.migrate)
# The server no longer serves package files; these are read only when migrating an old deployment.
AIHUB_STORAGE_BACKEND=local
# AIHUB_S3_BUCKET=my-aihub-packages
# AIHUB_S3_REGION=us-east-1
# AIHUB_S3_ENDPOINT=http://minio:9000       # leave empty for AWS S3. Set for MinIO / Cloudflare R2 / Ceph.
# AIHUB_S3_ACCESS_KEY=CHANGE_ME             # leave both empty on AWS to use an IAM role / the standard AWS credential chain
# AIHUB_S3_SECRET_KEY=CHANGE_ME
# AIHUB_S3_PREFIX=packages/
# AIHUB_S3_PATH_STYLE=true                  # MinIO needs true

# ---------------------------------------------------------------- usage events
AIHUB_EVENT_FLUSH_ROWS=50
AIHUB_EVENT_FLUSH_SECS=5
