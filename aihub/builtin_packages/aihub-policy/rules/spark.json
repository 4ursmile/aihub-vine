{
  "description": "spark",
  "rules": [
    {
      "id": "spark-overwrite-no-partition",
      "pattern": "^(?!.*(replaceWhere|partitionOverwriteMode|insertInto|overwritePartitions|/[A-Za-z_]+=[^/\\s\\\"'),]+)).*(\\.mode\\(\\s*[\\\"']overwrite[\\\"']\\s*\\)|\\bSaveMode\\.Overwrite\\b|\\.overwrite\\(\\s*\\)|\\.option\\(\\s*[\\\"']mode[\\\"']\\s*,\\s*[\\\"']overwrite[\\\"']|\\boverwrite\\s*=\\s*True)",
      "reason": "Spark/DataFrame write in overwrite mode that is not scoped to a partition (no replaceWhere, partitionOverwriteMode=dynamic, insertInto or dt=... path): replaces the whole table/path",
      "action": "deny",
      "tool": "Bash",
      "field": "command"
    },
    {
      "id": "spark-overwrite-no-partition-code",
      "pattern": "^(?!.*(replaceWhere|partitionOverwriteMode|insertInto|overwritePartitions|/[A-Za-z_]+=[^/\\s\\\"'),]+)).*(\\.mode\\(\\s*[\\\"']overwrite[\\\"']\\s*\\)|\\bSaveMode\\.Overwrite\\b|\\.overwrite\\(\\s*\\)|\\.option\\(\\s*[\\\"']mode[\\\"']\\s*,\\s*[\\\"']overwrite[\\\"']|\\boverwrite\\s*=\\s*True)",
      "reason": "Spark/DataFrame write in overwrite mode that is not scoped to a partition (no replaceWhere, partitionOverwriteMode=dynamic, insertInto or dt=... path): replaces the whole table/path (in code being written)",
      "action": "ask",
      "tool": "Write",
      "field": "content"
    },
    {
      "id": "spark-overwrite-no-partition-edit",
      "pattern": "^(?!.*(replaceWhere|partitionOverwriteMode|insertInto|overwritePartitions|/[A-Za-z_]+=[^/\\s\\\"'),]+)).*(\\.mode\\(\\s*[\\\"']overwrite[\\\"']\\s*\\)|\\bSaveMode\\.Overwrite\\b|\\.overwrite\\(\\s*\\)|\\.option\\(\\s*[\\\"']mode[\\\"']\\s*,\\s*[\\\"']overwrite[\\\"']|\\boverwrite\\s*=\\s*True)",
      "reason": "Spark/DataFrame write in overwrite mode that is not scoped to a partition (no replaceWhere, partitionOverwriteMode=dynamic, insertInto or dt=... path): replaces the whole table/path (in code being written)",
      "action": "ask",
      "tool": "Edit|MultiEdit",
      "field": "new_string"
    },
    {
      "id": "spark-overwrite-no-partition-nb",
      "pattern": "^(?!.*(replaceWhere|partitionOverwriteMode|insertInto|overwritePartitions|/[A-Za-z_]+=[^/\\s\\\"'),]+)).*(\\.mode\\(\\s*[\\\"']overwrite[\\\"']\\s*\\)|\\bSaveMode\\.Overwrite\\b|\\.overwrite\\(\\s*\\)|\\.option\\(\\s*[\\\"']mode[\\\"']\\s*,\\s*[\\\"']overwrite[\\\"']|\\boverwrite\\s*=\\s*True)",
      "reason": "Spark/DataFrame write in overwrite mode that is not scoped to a partition (no replaceWhere, partitionOverwriteMode=dynamic, insertInto or dt=... path): replaces the whole table/path (in code being written)",
      "action": "ask",
      "tool": "NotebookEdit",
      "field": "new_source"
    },
    {
      "id": "spark-drop",
      "pattern": "\\balter\\s+table\\s+\\S+\\s+drop\\s+(if\\s+exists\\s+)?partition|\\bdrop\\s+(view|function|temporary)|\\bvacuum\\b[^;]*retain\\s+0|\\bspark\\.catalog\\.(dropTempView|dropGlobalTempView)|\\.dropTable\\(|\\bDeltaTable\\b[^\\n]*\\.delete\\(\\s*\\)|\\.drop(Duplicates)?\\(\\s*\\)\\s*\\.write",
      "reason": "drops a Spark partition/view/function, vacuums with 0 retention or deletes a whole Delta table",
      "action": "deny",
      "tool": "Bash",
      "field": "command"
    },
    {
